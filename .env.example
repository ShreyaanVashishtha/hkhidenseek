# Supabase Configuration (Optional for local testing; required for live multi-device real-time sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (For Gemini Vision AI Referee & Veto Consequence Forecaster)
GEMINI_API_KEY=your-gemini-api-key

# CARTO Basemap Key (Optional - standard CARTO Dark Matter / Voyager basemaps are free and work without a key!)
# Only needed if you have a paid or enterprise CARTO workspace key for high tile quotas
NEXT_PUBLIC_CARTO_API_KEY=your-carto-api-key
